# ローカル開発専用の値です。公開サーバーにはそのまま使用しないでください。
DB_PASSWORD=scrum_dev
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_PORT=3307
API_PORT=8080
WEB_PORT=4200

# AIでカードを整える POST /api/cards/refined を使う場合だけ設定します（任意）。
# 未設定ならこのエンドポイントだけが503を返し、ほかの機能は影響を受けません。
# 実際のキーは.env（Git管理外）にだけ書き、このファイルには書かないでください。
# 注意: シェルにANTHROPIC_API_KEYをexportしていると、.envが空でもComposeはその値を使います。
ANTHROPIC_API_KEY=
# 使うモデル。空なら軽量な claude-haiku-5-5。effort指定に対応したモデルを指定してください。
ANTHROPIC_MODEL=
