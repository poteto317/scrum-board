# ローカル開発専用の値です。公開サーバーにはそのまま使用しないでください。
# APIに認証はありません。Composeのポート公開は 127.0.0.1 向けです。インターネットへ出さないでください。
DB_PASSWORD=scrum_dev
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_PORT=3307
API_PORT=8080
WEB_PORT=4200

# Optional: GitHub API token for PR title enrichment (public repo read only; omit scope for private repos).
# GITHUB_TOKEN=
# AIでカードを整える POST /api/cards/refined を使う場合だけ設定します（任意）。
# 未設定ならこのエンドポイントだけが503を返し、ほかの機能は影響を受けません。
# 実際のキーは.env（Git管理外）にだけ書き、このファイルには書かないでください。
# 注意: シェルにANTHROPIC_API_KEYをexportしていると、.envが空でもComposeはその値を使います。
ANTHROPIC_API_KEY=
# GCS bucket for item image attachments (empty → upload API returns 503; tests use MemoryBlobStorage)
# ATTACHMENT_GCS_BUCKET=
# 使うモデル。空なら軽量な claude-haiku-5-5。effort指定に対応したモデルを指定してください。
ANTHROPIC_MODEL=
# AI 呼び出し制限（既定オフ）。詳細は docs/ai-ops-limits.md
# AI_RATE_LIMIT_PER_MINUTE=
# AI_CHAT_MESSAGE_MAX=
# AI_CHAT_HISTORY_TURNS=
# AI_CHAT_MAX_OUTPUT_TOKENS=

# --- 以下は本番（Cloud Run + Cloud SQL）向けの変数名です。値は Git に載せず、
# Secret Manager または gcloud run services update で設定してください。ローカル Compose では不要です。
# GCP_PROJECT=daily-routine-app-8a832
# GCP_REGION=asia-northeast1
# AR_REPO=scrum-board
# SERVICE_NAME=scrum-board
# CLOUDSQL_INSTANCE=PROJECT:REGION:INSTANCE_ID
# DB_USER=scrum
# DB_PASSWORD=
# DB_NAME=scrumboard
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE_ID
# PUBLIC_ORIGIN=https://SERVICE-xxx.asia-northeast1.run.app
# AUTH_USER=
# AUTH_PASSWORD=
# Initial admin app login password. Must differ from AUTH_PASSWORD.
# Required by scripts/deploy-gcp.sh on every deploy (also after seed). Values are uploaded to Secret Manager
# and mounted with --set-secrets — not left as plaintext Cloud Run env vars.
# After first seed you can change the app password in-app; keep Basic (AUTH_*) and this secret separate; rotate values and restrict IAM.
# ADMIN_INITIAL_PASSWORD=
# Optional Secret Manager resource name overrides (defaults: scrum-board-*-password):
# SECRET_ID_DB_PASSWORD=
# SECRET_ID_AUTH_PASSWORD=
# SECRET_ID_ADMIN_INITIAL_PASSWORD=
# Shared token for Cloud Scheduler POST /api/trash/purge and /api/recurring/run (X-Scheduler-Token).
# SCHEDULER_JOB_TOKEN=
# SECRET_ID_SCHEDULER_JOB_TOKEN=
